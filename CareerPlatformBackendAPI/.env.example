# CareerPlatformBackendAPI - Example environment file
# Copy to ".env" and adjust values as needed. Do not commit your real secrets.

# Database (SQLite is default; no change required for local dev)
# DB_URL=sqlite:///./career_platform.db
# SQLITE_PATH=./career_platform.db

# JWT settings (use a strong key in real deployments)
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeding configuration
# Set SEED_FROM_JSON=1 to enable ingestion from JSON files under INGESTION_JSON_DIR on startup
SEED_FROM_JSON=1
INGESTION_JSON_DIR=data/imports

# Optional: Seed a few sample roles if the roles table is empty (only used if SEED_FROM_JSON=0)
SEED_SAMPLE_DATA=0

# Optional: Used by export stub for development plan URLs
REACT_APP_BACKEND_URL=http://localhost:3001
