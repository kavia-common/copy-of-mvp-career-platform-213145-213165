# Career Platform Backend API - Environment Variables (example)
# Copy to .env and set appropriate values per environment.

# JWT configuration
JWT_SECRET_KEY=replace-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeding / data ingestion
SEED_FROM_JSON=0
INGESTION_JSON_DIR=data/imports
SEED_SAMPLE_DATA=1

# Role Mapping Service (Node)
MAPPING_SERVICE_URL=http://localhost:4000
MAPPING_HTTP_TIMEOUT_SECONDS=2
MAPPING_HTTP_RETRIES=2

# CORS: comma-separated list of allowed origins
# For local dev with CRA:
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# NOTE: Database settings are configured in src/db/database.py (SQLite for local/tests).
