# Backend API - Example environment configuration
# Copy this file to ".env" and adjust values for your environment.

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-for-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (defaults to local SQLite if DB_URL is not set) ---
#DB_URL=sqlite:///./career_platform.db
#SQLITE_PATH=./career_platform.db

# --- Seeding from JSON (optional) ---
# Set to 1/true/yes to enable JSON ingestion on startup
SEED_FROM_JSON=0
INGESTION_JSON_DIR=data/imports
# Seed a few sample roles if roles table is empty (demo)
SEED_SAMPLE_DATA=0

# --- Role Mapping Service (Node) integration ---
# Base URL for the Node RoleMappingService (default http://localhost:4000)
MAPPING_SERVICE_URL=http://localhost:4000
# HTTP client settings
MAPPING_HTTP_TIMEOUT_SECONDS=2
MAPPING_HTTP_RETRIES=2

# --- Misc ---
# Used by the development plan export stub to compose URLs
REACT_APP_BACKEND_URL=http://localhost:3001
