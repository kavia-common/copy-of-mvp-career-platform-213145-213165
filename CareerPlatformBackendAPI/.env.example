# CareerPlatformBackendAPI - Example environment variables
# Copy this file to ".env" and adjust values for your environment.

# Database (SQLite by default)
# Full SQLAlchemy URL (overrides SQLITE_PATH if set)
DB_URL=sqlite:///./career_platform.db
# Alternatively, specify just the SQLite file path and let DB_URL default be built
# SQLITE_PATH=./career_platform.db

# Seeding controls
SEED_FROM_JSON=0
INGESTION_JSON_DIR=data/imports
SEED_SAMPLE_DATA=0

# Auth / JWT
JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS configuration (comma-separated list)
# Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Role Mapping Service (Node)
MAPPING_SERVICE_URL=http://localhost:4000
MAPPING_HTTP_TIMEOUT_SECONDS=2
MAPPING_HTTP_RETRIES=2

# Development plan export stub base URL
REACT_APP_BACKEND_URL=http://localhost:3001

# Logging
LOG_LEVEL=INFO
